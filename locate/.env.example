# LocateAnything API settings (env_prefix LOCATE_). Copy to .env to override.

# Server
LOCATE_HOST=0.0.0.0
LOCATE_PORT=8282
LOCATE_LOG_LEVEL=info

# Max generations running at once (queue cap). Set to 1 to fully serialize
# if 2 concurrent generations OOM or misbehave on a single GPU.
LOCATE_MAX_CONCURRENCY=2

# Seconds uvicorn waits for an in-flight generation to drain on Ctrl+C
# before force-exiting.
LOCATE_SHUTDOWN_GRACE_SECONDS=30

# Model / inference
LOCATE_MODEL_ID=nvidia/LocateAnything-3B
LOCATE_PRELOAD_MODEL=false
LOCATE_MAX_NEW_TOKENS=2048
